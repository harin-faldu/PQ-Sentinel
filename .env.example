# =====================================================================
# 🛡️ QuantumVault CBOM Scanner 2.0 — Environment Configuration Example
# =====================================================================
# Rename or copy this file to `.env` in the project root or backend folder:
# cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ---------------------------------------------------------------------
# Port on which the Go REST API Server runs (Default: 8080)
PORT=8080

# Allowed CORS origins for API requests (Default: *)
ALLOW_ORIGINS=*

# ---------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL)
# ---------------------------------------------------------------------
# Database driver: mysql, sqlite, or memory (Default: mysql)
DB_DRIVER=mysql

# MySQL Host, Port, User, Password, and Database Name
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=qv_cbom

# Optional custom MySQL Data Source Name (DSN). If set, overrides DB_HOST/USER/PASS settings.
# DB_SOURCE=root:your_db_password_here@tcp(127.0.0.1:3306)/qv_cbom?parseTime=true

# ---------------------------------------------------------------------
# 3. GITHUB APP INTEGRATION (1-Click Netlify-Style Authorization)
# ---------------------------------------------------------------------
# GitHub App ID (from github.com/settings/apps -> Your App)
GITHUB_APP_ID=your_github_app_id_here

# GitHub App Slug (used to generate the 1-Click Install URL)
GITHUB_APP_SLUG=your-github-app-slug-here

# Absolute path to your downloaded GitHub App RSA Private Key (.pem file)
GITHUB_PRIVATE_KEY_PATH=/path/to/your-github-app-private-key.pem

# Alternative: Raw PEM string content of your GitHub App RSA Private Key (if not using file path)
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ---------------------------------------------------------------------
# 4. SECRET BOX ENCRYPTION (Optional)
# ---------------------------------------------------------------------
# 32-byte hexadecimal key for encrypting stored tokens in database
# MASTER_KEY=your_32_byte_hex_master_key_here
